<!doctype html>
<html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width">
    <meta name="title" content="Diginext">
    <meta name="description" content="Diginext">
    <meta name="robots" content="index, follow">
    <meta name="language" content="English">
    <meta name="revisit-after" content="30 days">
<title>Diginext - Portfolio - Case Study - Tim (Timber) Hjellum</title>

		<meta property="og:image:width" content="1280" />
<meta property="og:image:height" content="720" />
<meta property="og:locale" content="en_US" />
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/images/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="stylesheet" href="./style.css" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,600&family=Archivo:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600&display=swap">
<style>
  :root{
    --bg:#121212;
    --bg-panel:#1a1a1a;
    --bg-panel-2:#212121;
    --text:#ececec;
    --text-dim:#a0a0a0;
    --accent:#6cb2ff;
    --pop:#5c6cc4;
    --line:rgba(255,255,255,.10);
    --glow:108,178,255;
    --hero-scrim:6,8,12;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:"Archivo",system-ui,sans-serif;
    -webkit-font-smoothing:antialiased;
    position:relative;
  }
  /* film-grain: the one decorative flourish, borrowed from DigiNext's
     own screening-room aesthetic */
  body::after{
    content:""; position:fixed; inset:0; z-index:999; pointer-events:none;
    opacity:.04; mix-blend-mode:overlay;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  .display{
    font-family:"Fraunces",serif;
    font-weight:700;
    line-height:1.14;
    letter-spacing:-.005em;
  }
  .display em{ font-style:italic; font-weight:600; color:var(--pop); }
  .display em.pop{ color:var(--pop); }
  .kicker{
    font-family:"IBM Plex Mono",monospace;
    font-weight:500;
    letter-spacing:.14em;
    text-transform:uppercase;
    font-size:12px;
    color:var(--accent);
  }
  .card{
    background:var(--bg-panel);
    border:1px solid var(--line);
    border-radius:6px;
  }
  .tag{
    font-size:13px;
    font-weight:600;
    padding:8px 16px;
    border-radius:999px;
    border:1px solid var(--line);
    background:var(--bg-panel);
    color:var(--text-dim);
    white-space:nowrap;
  }
  :focus-visible{ outline:2px solid var(--accent); outline-offset:3px; }

  .page{ display:flex; flex-direction:column; }

  /* ===== top bar ===== */
  .topbar{
    display:flex; align-items:center; justify-content:space-between;
    padding:26px clamp(20px,6vw,64px);
    border-bottom:1px solid var(--line);
  }
  .topbar .meta{ font-size:12px; letter-spacing:.1em; text-transform:uppercase; color:var(--text-dim); font-weight:600; }

  /* ===== hero ===== */
  .hero{
    position:relative;
    overflow:hidden;
    min-height:min(520px,74svh);
    display:flex;
    align-items:center;
    padding:clamp(56px,10vw,96px) clamp(20px,6vw,64px) clamp(64px,10vw,100px);
    background-image:url("data:image/jpeg;base64,");
    background-size:cover;
    background-position:center;
  }
  .hero::before{
    content:""; position:absolute; inset:0;
    background:linear-gradient(100deg, rgba(var(--hero-scrim),.92) 0%, rgba(var(--hero-scrim),.68) 42%, rgba(var(--hero-scrim),.34) 68%, rgba(var(--hero-scrim),.55) 100%);
  }
  .hero::after{
    content:""; position:absolute; inset:0;
    background:linear-gradient(180deg, var(--bg) 0%, rgba(var(--hero-scrim),0) 14%, rgba(var(--hero-scrim),0) 84%, var(--bg) 100%);
  }
  .hero-inner{ position:relative; max-width:600px; }
  .hero-logo{ height:30px; margin-bottom:22px; filter:drop-shadow(0 2px 10px rgba(0,0,0,.6)); mix-blend-mode:screen; }
  .hero-inner .kicker{ margin-bottom:18px; }
  .hero-inner h1{ font-size:clamp(2.2rem,5vw,3.8rem); margin:0 0 26px; color:#ffffff; text-wrap:balance; }
  .hero-inner h1 em{ color:var(--accent); text-shadow:0 0 22px rgba(var(--glow),.55); }
  .hero-inner p{ font-size:clamp(1rem,1.5vw,1.1rem); line-height:1.65; color:rgba(236,236,236,.82); max-width:520px; margin:0; }

  .rule{ height:3px; background:linear-gradient(90deg, var(--accent), var(--pop)); }

  /* ===== scattered screens -> one taxonomy ===== */
  .consolidate{
    display:flex; align-items:center; justify-content:center; gap:clamp(14px,3vw,32px);
    flex-wrap:wrap;
    padding:34px clamp(20px,6vw,64px);
    background:var(--bg-panel-2);
    border-bottom:1px solid var(--line);
  }
  .platform-stack{ display:flex; flex-direction:column; gap:8px; }
  .platform-pill{
    font-size:12px; font-weight:600; color:var(--text-dim);
    border:1px solid var(--line); border-radius:999px;
    background:var(--bg-panel);
    padding:6px 14px; text-align:center;
  }
  .consolidate-arrow{ color:var(--accent); font-size:1.4rem; }
  .app-box{
    font-family:"Fraunces",serif;
    font-weight:700; font-size:clamp(1rem,2vw,1.3rem);
    color:var(--bg); background:var(--accent);
    border-radius:8px;
    padding:20px 30px;
    text-align:center;
  }

  /* ===== challenge ===== */
  .challenge{
    padding:clamp(48px,8vw,64px) clamp(20px,6vw,64px) clamp(56px,8vw,72px);
    display:flex; gap:48px; flex-wrap:wrap; justify-content:center;
  }
  .challenge .label{ flex:0 0 auto; }
  .challenge p{ flex:1 1 620px; max-width:720px; font-size:clamp(1.05rem,1.8vw,1.3rem); line-height:1.65; color:var(--text); margin:0; font-weight:500; }

  /* ===== my role ===== */
  .role{ padding:clamp(56px,9vw,72px) clamp(20px,6vw,64px); border-top:1px solid var(--line); }
  .role-head{ text-align:center; margin-bottom:36px; }
  .role-head .kicker{ margin-bottom:14px; }
  .role-head h2{ font-size:clamp(1.7rem,3.4vw,2.6rem); margin:0 0 20px; color:var(--text); }
  .role-tags{ display:flex; gap:12px; justify-content:center; flex-wrap:wrap; margin-bottom:18px; }
  .role-tags .tag{ color:var(--accent); border-color:var(--accent); }
  .role-head .sub{ max-width:600px; margin:0 auto; color:var(--text-dim); font-size:16px; line-height:1.6; }

  .steps{
    display:grid;
    grid-template-columns:repeat(4, minmax(0,1fr));
    gap:16px;
    max-width:1120px;
    margin:0 auto;
  }
  @media (max-width:900px){ .steps{ grid-template-columns:repeat(2, minmax(0,1fr)); } }
  @media (max-width:520px){ .steps{ grid-template-columns:1fr; } }
  .steps .card{ padding:22px; }
  .steps .num{ font-size:12px; font-weight:700; letter-spacing:.08em; color:var(--accent); margin-bottom:10px; font-variant-numeric:tabular-nums; font-family:"IBM Plex Mono",monospace; }
  .steps .title{ font-weight:700; font-size:16px; margin-bottom:8px; }
  .steps .desc{ font-size:14px; line-height:1.55; color:var(--text-dim); }

  /* ===== skills ===== */
  .skills{ padding:clamp(56px,9vw,72px) clamp(20px,6vw,64px); border-top:1px solid var(--line); text-align:center; }
  .skills .kicker{ margin-bottom:14px; display:block; }
  .skills h2{ font-size:clamp(1.6rem,3vw,2.2rem); margin:0 0 30px; color:var(--text); }
  .skill-tags{ display:flex; gap:10px; flex-wrap:wrap; justify-content:center; max-width:880px; margin:0 auto; }

  /* ===== closing ===== */
  .closing{
    position:relative; padding:clamp(64px,11vw,96px) clamp(20px,6vw,64px);
    border-top:1px solid var(--line); overflow:hidden;
    background:radial-gradient(ellipse 70% 120% at 50% 40%, var(--bg-panel-2) 0%, var(--bg) 72%);
  }
  .closing-inner{ position:relative; text-align:center; max-width:680px; margin:0 auto; }
  .closing h2{ font-size:clamp(2.1rem,4.6vw,3.3rem); margin:0 0 18px; color:var(--text); }
  .closing h2 em{ text-shadow:0 0 22px rgba(var(--glow),.4); }
  .closing p{ font-size:16px; line-height:1.6; color:var(--text-dim); margin:0; }

  /* ===== footer ===== */
  footer{
    padding:24px clamp(20px,6vw,64px);
    border-top:1px solid var(--line);
    display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px;
    font-size:12px; color:var(--text-dim);
  }

  /* ===== gallery ===== */
  .gal-section{ padding:clamp(56px,9vw,72px) clamp(20px,6vw,64px); border-top:1px solid var(--line); text-align:center; }
  .gal-section .kicker{ margin-bottom:14px; display:block; }
  .gal-section h2{ font-size:clamp(1.6rem,3vw,2.2rem); margin:0 0 12px; color:var(--text); }
  .gal-sub{ color:var(--text-dim); font-size:14px; margin:0 0 36px; }

  .gal-grid{
    display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:16px;
    max-width:1120px; margin:0 auto; text-align:left;
  }
  @media (max-width:900px){ .gal-grid{ grid-template-columns:repeat(2, minmax(0,1fr)); } }
  @media (max-width:520px){ .gal-grid{ grid-template-columns:1fr; } }

  .gal-item{
    all:unset; cursor:pointer; display:block;
    background:var(--bg-panel); border:1px solid var(--line); border-radius:8px; overflow:hidden;
    transition:transform .3s cubic-bezier(.16,1,.3,1), border-color .3s ease, box-shadow .3s ease;
  }
  .gal-item:hover, .gal-item:focus-visible{
    transform:translateY(-4px); border-color:var(--accent); box-shadow:0 16px 32px -20px rgba(0,0,0,.6), 0 0 24px -8px rgba(var(--glow),.35);
  }
  .gal-item:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; }

  .gal-thumb{
    aspect-ratio:4/3; position:relative;
    background:repeating-linear-gradient(135deg, transparent 0 8px, var(--line) 8px 9px);
    display:flex; align-items:center; justify-content:center; overflow:hidden;
  }
  .gal-thumb img{ width:100%; height:100%; object-fit:cover; display:block; }
  .gal-placeholder-mark{
    font-family:"IBM Plex Mono",monospace;
    font-size:10.5px; letter-spacing:.08em; text-transform:uppercase;
    color:var(--text-dim); background:var(--bg); border:1px solid var(--line); border-radius:999px; padding:4px 10px;
  }
  .gal-cap{ padding:14px 16px 16px; }
  .gal-cap-title{ display:block; font-weight:700; font-size:14px; color:var(--text); margin-bottom:4px; }
  .gal-cap-desc{ display:block; font-size:12.5px; line-height:1.5; color:var(--text-dim); }

  .gal-lightbox{
    position:fixed; inset:0; z-index:1000; display:flex; align-items:center; justify-content:center;
    padding:5vh 4vw; background:rgba(0,0,0,.82); opacity:0; pointer-events:none; transition:opacity .25s ease;
  }
  .gal-lightbox.is-open{ opacity:1; pointer-events:auto; }
  .gal-lightbox-dialog{
    position:relative; max-width:min(920px,92vw); width:100%;
    background:var(--bg-panel); border:1px solid var(--line); border-radius:10px; overflow:hidden;
    transform:scale(.96) translateY(10px); transition:transform .3s cubic-bezier(.16,1,.3,1);
  }
  .gal-lightbox.is-open .gal-lightbox-dialog{ transform:scale(1) translateY(0); }
  .gal-lightbox-frame{
    aspect-ratio:16/10; position:relative; display:flex; align-items:center; justify-content:center;
    background:repeating-linear-gradient(135deg, transparent 0 8px, var(--line) 8px 9px);
  }
  .gal-lightbox-frame img{ width:100%; height:100%; object-fit:cover; display:none; position:absolute; inset:0; }
  .gal-lightbox-placeholder{
    font-family:"IBM Plex Mono",monospace;
    font-size:12px; letter-spacing:.06em; text-transform:uppercase;
    color:var(--text-dim); background:var(--bg); border:1px solid var(--line); border-radius:999px; padding:6px 14px;
  }
  .gal-lightbox-meta{
    display:flex; align-items:center; justify-content:space-between; gap:16px;
    padding:16px 20px; border-top:1px solid var(--line);
  }
  .gal-lightbox-meta .gal-cap-title{ font-size:15px; }
  .gal-lightbox-counter{
    font-family:"IBM Plex Mono",monospace; font-size:12px; color:var(--text-dim); white-space:nowrap;
  }
  .gal-lightbox-close, .gal-lightbox-nav{
    position:absolute; width:38px; height:38px; border-radius:50%;
    border:1px solid var(--line); background:var(--bg); color:var(--text);
    display:flex; align-items:center; justify-content:center; cursor:pointer;
    transition:background .15s ease, transform .15s ease, border-color .15s ease, color .15s ease;
    font-size:18px; line-height:1;
  }
  .gal-lightbox-close{ top:12px; right:12px; z-index:2; }
  .gal-lightbox-nav{ top:50%; transform:translateY(-50%); z-index:2; }
  .gal-lightbox-prev{ left:12px; }
  .gal-lightbox-next{ right:12px; }
  .gal-lightbox-close:hover, .gal-lightbox-nav:hover:not(:disabled){ border-color:var(--accent); color:var(--accent); }
  .gal-lightbox-nav:disabled{ opacity:.3; cursor:not-allowed; }
  @media (max-width:640px){ .gal-lightbox-dialog{ max-width:94vw; } }
</style>
</head>
<body>

<div class="page">

  <div class="topbar">
    <div class="kicker">Portfolio Case Study</div>
    <div class="meta">Streaming &amp; Entertainment</div>
  </div>

  <div class="hero">
    <div class="hero-inner">
      <img class="hero-logo" src="data:image/jpeg;base64," alt="DigiNext — Movies That Matter" />
      <div class="kicker">DigiNext Films &middot; Future Platform</div>
      <h1 class="display">One taxonomy.<br>Every <em>screen</em>.</h1>
      <p>DigiNext needed a fully responsive website and application that could span mobile apps, Roku, Prime Video, and Netflix television apps and channels &mdash; all from one shared information architecture.</p>
    </div>
  </div>
  <div class="rule"></div>

  <div class="consolidate">
    <div class="platform-stack">
      <div class="platform-pill">Mobile App</div>
      <div class="platform-pill">Roku</div>
      <div class="platform-pill">Prime Video</div>
      <div class="platform-pill">Netflix Channel</div>
    </div>
    <div class="consolidate-arrow">&rarr;</div>
    <div class="app-box">One Taxonomy</div>
  </div>

  <div class="challenge">
    <div class="label"><div class="kicker">The Challenge</div></div>
    <p>The future DigiNext needed a single, fully responsive experience spanning its own website and app alongside Roku, Prime Video, and Netflix television apps and channels &mdash; each with different navigation conventions, but all needing to feel like the same service.</p>
  </div>

  <div class="role">
    <div class="role-head">
      <div class="kicker">My Role</div>
      <h2 class="display">One catalog, built to fit any screen.</h2>
      <div class="role-tags">
        <span class="tag">Lead Information Architect</span>
        <span class="tag">UX Designer</span>
      </div>
      <p class="sub">I owned the information architecture and user experience for the future DigiNext, across every platform it would appear on.</p>
    </div>

    <div class="steps"></div>
  </div>

  <div class="gal-section">
    <span class="kicker">Selected Screens</span>
    <h2 class="display">The application</h2>
    <p class="gal-sub">Click a screen to enlarge.</p>
    <div class="gal-grid" id="galGrid">

      <button type="button" class="gal-item" data-index="0">
        <span class="gal-thumb"><img src="data:image/jpeg;base64," alt="DigiNext movie detail page" /></span>
        <span class="gal-cap">
          <span class="gal-cap-title">Movie Detail Page</span>
          <span class="gal-cap-desc">Genre, rating, cast, and purchase options brought into one consistent detail-page taxonomy.</span>
        </span>
      </button>

      <button type="button" class="gal-item" data-index="1">
        <span class="gal-thumb"><span class="gal-placeholder-mark">Preview 02</span></span>
        <span class="gal-cap">
          <span class="gal-cap-title">Home Shelf Browse</span>
          <span class="gal-cap-desc">Curated shelves organized by popularity, genre, and award status.</span>
        </span>
      </button>

      <button type="button" class="gal-item" data-index="2">
        <span class="gal-thumb"><span class="gal-placeholder-mark">Preview 03</span></span>
        <span class="gal-cap">
          <span class="gal-cap-title">Cross-Platform Navigation</span>
          <span class="gal-cap-desc">The same taxonomy adapted to Roku and Prime Video navigation conventions.</span>
        </span>
      </button>

      <button type="button" class="gal-item" data-index="3">
        <span class="gal-thumb"><span class="gal-placeholder-mark">Preview 04</span></span>
        <span class="gal-cap">
          <span class="gal-cap-title">Responsive Grid Template</span>
          <span class="gal-cap-desc">A hand-coded responsive template applied consistently across web and app.</span>
        </span>
      </button>

      </div>
    </div>

  <div class="gal-lightbox" id="galLightbox" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="galLightboxTitle">
    <div class="gal-lightbox-dialog">
      <button type="button" class="gal-lightbox-close" id="galLightboxClose" aria-label="Close">&times;</button>
      <button type="button" class="gal-lightbox-nav gal-lightbox-prev" id="galLightboxPrev" aria-label="Previous screen">&larr;</button>
      <button type="button" class="gal-lightbox-nav gal-lightbox-next" id="galLightboxNext" aria-label="Next screen">&rarr;</button>
      <div class="gal-lightbox-frame">
        <img id="galLightboxImg" src="" alt="" />
        <span class="gal-lightbox-placeholder" id="galLightboxPlaceholder">Screen preview coming soon</span>
      </div>
      <div class="gal-lightbox-meta">
        <div>
          <span class="gal-cap-title" id="galLightboxTitle"></span><br>
          <span class="gal-cap-desc" id="galLightboxDesc"></span>
    </div>
        <span class="gal-lightbox-counter" id="galLightboxCounter"></span>
      </div>
    </div>
      </div>

  <div class="skills">
    <span class="kicker">Skills &amp; Technologies</span>
    <h2 class="display">The toolkit behind it</h2>
    <div class="skill-tags"></div>
    </div>

  <div class="closing">
    <div class="closing-inner">
      <h2 class="display">One taxonomy.<br>Every <em class="pop">screen</em>, the same story.</h2>
      <p>Genre, rating, access, popularity, awards, and year &mdash; one shared taxonomy built to carry DigiNext across a responsive site, an app, and every television platform it would need to reach.</p>
    </div>
  </div>

  <footer>
    <div>DigiNext Films &middot; Movies That Matter</div>
    <div>Information Architecture &middot; UX Design</div>
  </footer>
</div>

<script>
  (function(){
    var items = Array.prototype.slice.call(document.querySelectorAll('#galGrid .gal-item'));
    if (!items.length) return;
    var lightbox = document.getElementById('galLightbox');
    var imgEl = document.getElementById('galLightboxImg');
    var placeholderEl = document.getElementById('galLightboxPlaceholder');
    var titleEl = document.getElementById('galLightboxTitle');
    var descEl = document.getElementById('galLightboxDesc');
    var counterEl = document.getElementById('galLightboxCounter');
    var closeBtn = document.getElementById('galLightboxClose');
    var prevBtn = document.getElementById('galLightboxPrev');
    var nextBtn = document.getElementById('galLightboxNext');
    var current = 0;
    var lastFocused = null;

    function render(){
      var el = items[current];
      var title = el.querySelector('.gal-cap-title').textContent;
      var desc = el.querySelector('.gal-cap-desc').textContent;
      var srcImg = el.querySelector('img');
      if (srcImg) {
        imgEl.src = srcImg.currentSrc || srcImg.src;
        imgEl.alt = srcImg.alt || title;
        imgEl.style.display = 'block';
        placeholderEl.style.display = 'none';
      } else {
        imgEl.removeAttribute('src');
        imgEl.style.display = 'none';
        placeholderEl.style.display = 'flex';
      }
      titleEl.textContent = title;
      descEl.textContent = desc;
      counterEl.textContent = (current + 1) + ' / ' + items.length;
      prevBtn.disabled = current === 0;
      nextBtn.disabled = current === items.length - 1;
    }
    function open(index){
      current = index;
      lastFocused = document.activeElement;
      render();
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
      document.addEventListener('keydown', onKeydown);
    }
    function close(){
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);
      if (lastFocused) lastFocused.focus();
    }
    function go(delta){
      var next = current + delta;
      if (next < 0 || next >= items.length) return;
      current = next;
      render();
    }
    function onKeydown(e){
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') go(1);
      if (e.key === 'ArrowLeft') go(-1);
    }

    items.forEach(function(el, i){
      el.addEventListener('click', function(){ open(i); });
    });
    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', function(){ go(-1); });
    nextBtn.addEventListener('click', function(){ go(1); });
    lightbox.addEventListener('click', function(e){ if (e.target === lightbox) close(); });
  })();
</script>
		<script type="module" src="./script.js"></script>
	<script async src="https://www.googletagmanager.com/gtag/js?id=G-GRS0JMB0V6"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());

    gtag('config', 'G-GRS0JMB0V6');
</script>
</body>
</html>